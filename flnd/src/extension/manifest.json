{
  "manifest_version": 3,
  "name": "flnd",
  "version": "1.0.0",
  "description": "Lets flnd on this computer read this browser's cookies and pages.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "tabs",
    "debugger",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.fb.watch/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.loix.cc/*",
    "*://*.moegoat.com/*",
    "*://*.t.me/*",
    "*://*.telegram.org/*",
    "*://*.mimihentai.moe/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "flnd",
    "default_popup": "popup.html"
  }
}
